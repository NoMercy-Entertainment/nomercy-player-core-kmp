{
  "contractVersion": "2.0.4",
  "scenarios": [
    {
      "id": "transport/play",
      "name": "play announces itself before it happens, then reports that it did",
      "medium": "both",
      "playlist": [
        {
          "id": "a",
          "title": "A",
          "url": "https://example.test/a"
        }
      ],
      "actions": [
        {
          "method": "play"
        }
      ],
      "expect": [
        "beforePlay",
        "play",
        "playing"
      ]
    },
    {
      "id": "transport/play-prevented",
      "name": "a listener refusing beforePlay stops playback and says so",
      "medium": "both",
      "playlist": [
        {
          "id": "a",
          "title": "A",
          "url": "https://example.test/a"
        }
      ],
      "actions": [
        {
          "preventVia": "beforePlay"
        },
        {
          "method": "play"
        }
      ],
      "expect": [
        "beforePlay",
        "playPrevented"
      ]
    },
    {

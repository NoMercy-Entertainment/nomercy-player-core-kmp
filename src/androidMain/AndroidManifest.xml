<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- What a system transport needs to keep playing with the screen off.
         Merged from the library so an app adopting it does not have to know
         which permissions its player wants; the app's own manifest keeps
         whatever else it declares. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Merged into androidx.startup's own provider rather than declaring a
             second one with its own authority. Two providers naming the same
             class collide the moment anything else pulls startup-runtime in,
             which is what the device-test APK does. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="tv.nomercy.player.core.ports.PlayerCoreInitializer"
                android:value="androidx.startup" />
        </provider>

        <!-- What keeps the process alive with the screen off (P21.20), and
             what a car finds when it looks for something to play.

             android:exported="true" is not optional here: a Bluetooth head
             unit builds its player list by enumerating BROWSABLE media
             services in other processes, and so do Android Auto and the
             assistant. Exported="false" is visible only to this app's own
             MediaController — which is why NoMercy never appeared on a head
             unit and its cover art never loaded there. What an outside
             caller can actually do is still decided by the session's own
             onConnect (see Media3SystemTransport.TransportSessionCallback);
             exporting makes the service findable, not open.

             Three actions, because three different callers look for three
             different names: media3 controllers use the MediaLibraryService
             action, older media3 and framework controllers use the
             MediaSessionService one, and the legacy browse enumerator every
             car still uses looks for android.media.browse.MediaBrowserService.
             A service missing that last one is controllable once something
             else starts it and invisible in the car's own player list. -->
        <service
            android:name="tv.nomercy.player.core.ports.NoMercyPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>

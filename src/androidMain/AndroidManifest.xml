<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- What a system transport needs to keep playing with the screen off.
         Merged from the library so an app adopting it does not have to know
         which permissions its player wants; the app's own manifest keeps
         whatever else it declares. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Merged into androidx.startup's own provider rather than declaring a
             second one with its own authority. Two providers naming the same
             class collide the moment anything else pulls startup-runtime in,
             which is what the device-test APK does. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="tv.nomercy.player.core.ports.PlayerCoreInitializer"
                android:value="androidx.startup" />
        </provider>

        <!-- What keeps the process alive with the screen off (P21.20).
             android:exported="false": only this app's own MediaController
             and the framework's MediaSessionManager (the lock screen, the
             notification, Android Auto) ever bind to it, never another
             app's process directly. The intent-filter action is the
             standard framework contract androidx.media3.session.MediaSessionService
             consumers all declare — it is what makes the system able to
             find this Service by capability rather than by name. -->
        <service
            android:name="tv.nomercy.player.core.ports.NoMercyPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
